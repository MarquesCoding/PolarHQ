# PolarHQ demo — environment for docker-compose.demo.yml.
# Copy to `.env` ON THE VPS (next to the compose file) and fill in. NEVER commit the real .env.
#   cp demo.env.example .env && nano .env

# Public origin the app is reached at (used for API_URL + WEB_URL).
PUBLIC_URL=https://demo.polarhq.app

# Bare hostname Caddy issues the TLS cert for. Must match PUBLIC_URL's host.
DOMAIN=demo.polarhq.app

# Auth signing secret — generate your own:  openssl rand -base64 32
AUTH_SECRET=

# Postgres password (anything; it's internal to the compose network).
POSTGRES_PASSWORD=change-me

# Optional display name.
APP_NAME=PolarHQ
