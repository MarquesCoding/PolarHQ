# PolarHQ production stack — copy to docker/.env and fill in.
#   docker compose -f docker/docker-compose.yml --env-file docker/.env up -d

# REQUIRED — generate with: openssl rand -base64 32
AUTH_SECRET=

# Container images (pin to a tag/sha in real deployments)
APP_IMAGE=ghcr.io/marquescoding/polarhq-app:latest
WEB_IMAGE=ghcr.io/marquescoding/polarhq-web:latest

# Public URLs — must be reachable from the browser.
# NOTE: the browser's API base is baked into the web image at build time
# (NEXT_PUBLIC_API_URL). To serve on a domain, rebuild the web image with
# --build-arg NEXT_PUBLIC_API_URL=https://api.your-domain and set API_URL/WEB_URL here.
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
API_PORT=3001
WEB_PORT=3000

APP_NAME=PolarHQ

# Bundled infrastructure credentials (defaults are fine for a private box)
POSTGRES_USER=orbit
POSTGRES_PASSWORD=orbit
POSTGRES_DB=orbit
MINIO_ROOT_USER=orbitadmin
MINIO_ROOT_PASSWORD=orbitadmin
S3_BUCKET=orbit-media
