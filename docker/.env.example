# PolarHQ production stack — copy to docker/.env and fill in.
#   docker compose -f docker/docker-compose.yml --env-file docker/.env up -d

# REQUIRED — generate with: openssl rand -base64 32
AUTH_SECRET=

# Container images (pin to a tag/sha in real deployments)
APP_IMAGE=ghcr.io/marquescoding/polarhq-app:latest
WEB_IMAGE=ghcr.io/marquescoding/polarhq-web:latest

# The single public port the whole stack is served on — set this to anything.
HTTP_PORT=8080

# The public origin users reach the app at (the proxy). Used for CORS + links.
# Set to your domain in production, e.g. https://polarhq.example.com
PUBLIC_URL=http://localhost:8080

APP_NAME=PolarHQ

# Bundled infrastructure credentials (defaults are fine for a private box)
POSTGRES_USER=orbit
POSTGRES_PASSWORD=orbit
POSTGRES_DB=orbit
MINIO_ROOT_USER=orbitadmin
MINIO_ROOT_PASSWORD=orbitadmin
S3_BUCKET=orbit-media
