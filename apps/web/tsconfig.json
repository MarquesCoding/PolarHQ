{
  "extends": "@polarhq/typescript-config/base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "allowJs": true,
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "@/*": ["./*"],
      "@lib/*": ["./lib/*"],
      "@polarhq/interface/*": ["../../packages/interface/src/*"],
      "@polarhq/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": [
    "src",
    "components",
    "screens",
    "lib",
    "store",
    "vite.config.ts",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": ["node_modules", "dist"]
}
