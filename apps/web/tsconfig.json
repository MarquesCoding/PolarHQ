{
  "extends": "@workspace/typescript-config/react-library.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@components/*": [
        "../../packages/screens/src/components/*"
      ],
      "@pages/*": [
        "../../packages/screens/src/screens/*"
      ],
      "@lib/*": [
        "./lib/*"
      ],
      "@workspace/ui/*": [
        "../../packages/ui/src/*"
      ]
    }
  },
  "include": [
    "src",
    "lib",
    "hooks",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
