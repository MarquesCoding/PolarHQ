{
  "expo": {
    "name": "PolarHQ",
    "slug": "polarhq",
    "version": "0.5.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "polarhq",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "app.polarhq.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "app.polarhq.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b0b14",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-secure-store",
      "react-native-libsodium",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PolarHQ to upload photos from your library."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow PolarHQ to back up photos and videos from your library.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-video",
      "expo-background-task",
      [
        "expo-notifications",
        {
          "color": "#7c5cfc"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
