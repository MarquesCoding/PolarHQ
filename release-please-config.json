{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "changelog-sections": [
    { "type": "feat", "section": "Added" },
    { "type": "fix", "section": "Fixed" },
    { "type": "perf", "section": "Improved" },
    { "type": "refactor", "section": "Improved" },
    { "type": "revert", "section": "Fixed" },
    { "type": "docs", "section": "Docs", "hidden": true },
    { "type": "chore", "section": "Chore", "hidden": true },
    { "type": "style", "hidden": true },
    { "type": "test", "hidden": true }
  ],
  "packages": {
    ".": {
      "extra-files": [
        { "type": "json", "path": "apps/desktop/src-tauri/tauri.conf.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/desktop/package.json", "jsonpath": "$.version" }
      ]
    }
  }
}
