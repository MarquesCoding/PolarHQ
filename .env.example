# ---- Vault environment (copy to .env for local dev) ----

NODE_ENV=development
APP_NAME=PolarHQ

# API
API_PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# Auth (generate a strong secret: `openssl rand -base64 32`)
AUTH_SECRET=dev-secret-change-me-0123456789abcdef

# Database (Postgres + pgvector)
DATABASE_URL=postgres://vault:vault@localhost:5432/vault

# Redis (BullMQ + pub/sub)
REDIS_URL=redis://localhost:6379

# Storage: "s3" (MinIO/S3) or "fs" (local filesystem)
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=vaultadmin
S3_SECRET_ACCESS_KEY=vaultadmin
S3_BUCKET=vault-media
S3_FORCE_PATH_STYLE=true

# Used only when STORAGE_DRIVER=fs
STORAGE_FS_ROOT=./.data/storage

# Icons (optional): provide a Nucleo license key to install the premium
# `nucleo-core-fill-24` icon pack. Leave blank to fall back to Tabler icons.
# The key is read at install time, e.g. `set -a; source .env; set +a; pnpm install`.
NUCLEO_LICENSE_KEY=
