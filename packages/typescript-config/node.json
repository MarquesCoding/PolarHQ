{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Node Service",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "target": "ES2022",
    "declaration": false,
    "declarationMap": false,
    "noEmit": true
  }
}
